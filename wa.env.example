# Copy to wa.env (or .env) and fill in values from Meta for Developers.
# Plain KEY=VALUE lines, no quotes, no "export".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Demo dealers for the WhatsApp conversation flow (digits only, with country code).
# COUNTRY = ID / MM / KH (market + verification providers), TIER = STANDARD / EXCELLENT (customer badge).
DEMO_DEALER_1_PHONE=6285772932908
DEMO_DEALER_1_NAME=JBFEI Chris
DEMO_DEALER_1_COUNTRY=ID
DEMO_DEALER_1_TIER=EXCELLENT
DEMO_DEALER_2_PHONE=6285772932902
DEMO_DEALER_2_NAME=JBFI Lee
DEMO_DEALER_2_COUNTRY=ID
DEMO_DEALER_2_TIER=STANDARD
# Optional Myanmar / Cambodia dealers (skipped when the phone is blank)
DEMO_DEALER_3_PHONE=
DEMO_DEALER_3_NAME=Demo Dealer Myanmar
DEMO_DEALER_4_PHONE=
DEMO_DEALER_4_NAME=Demo Dealer Cambodia
# Shared key for the back-office /admin/** endpoints (X-Admin-Key header)
ADMIN_API_KEY=
# Business number for wa.me links (optional)
WHATSAPP_BUSINESS_PHONE=
VERIFICATION_COUNTRY=ID

# Fake applications for the dashboard / review demo (created once at startup when none exist; DELETE /admin/demo/seed removes them)
DEMO_SEED_APPLICATIONS=false
DEMO_SEED_COUNT=40

# Document analysis: stub (demo) or claude. With claude, set the Anthropic API key.
DOCUMENT_CHECK=stub
ANTHROPIC_API_KEY=
