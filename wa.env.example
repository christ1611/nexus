# Copy to wa.env (or .env) and fill in values from Meta for Developers.
# Plain KEY=VALUE lines, no quotes, no "export".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Demo dealers for the WhatsApp conversation flow (digits only, with country code)
DEMO_DEALER_1_PHONE=6285772932908
DEMO_DEALER_1_NAME=JBFEI Chris
DEMO_DEALER_2_PHONE=6285772932902
DEMO_DEALER_2_NAME=JBFI Lee
# Shared key for the back-office /admin/** endpoints (X-Admin-Key header)
ADMIN_API_KEY=
# Business number for wa.me links (optional)
WHATSAPP_BUSINESS_PHONE=
VERIFICATION_COUNTRY=ID

# Document analysis: stub (demo) or claude. With claude, set the Anthropic API key.
DOCUMENT_CHECK=stub
ANTHROPIC_API_KEY=
